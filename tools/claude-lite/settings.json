{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "dontAsk",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Edit",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(make bench)",
      "Bash(make check-clean)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.config/**)",
      "Edit(~/.config/**)",
      "Bash(strings *)",
      "Bash(rm -rf *)",
      "Bash(ssh *)",
      "Bash(aws *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "mcp__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 \"$AGENT_LITE_RUN_ROOT/hooks.py\" pre"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 \"$AGENT_LITE_RUN_ROOT/hooks.py\" post"}]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{"type": "command", "command": "python3 \"$AGENT_LITE_RUN_ROOT/hooks.py\" compact"}]
      }
    ]
  }
}