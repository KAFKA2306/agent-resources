[Unit]
Description=OpenClaw autonomous GitHub issue supervisor
Requires=freetoken.service openclaw-gateway.service
After=freetoken.service openclaw-gateway.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/openclaw-autonomous-worker/env
ExecStart=/usr/bin/python3 ${AGENT_RESOURCES_ROOT}/scripts/openclaw-autonomous-worker/supervisor.py --config ${WORKER_CONFIG}
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
