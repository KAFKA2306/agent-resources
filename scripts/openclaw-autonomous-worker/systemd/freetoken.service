[Unit]
Description=FreeToken Ornith local inference
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/openclaw-autonomous-worker/env
ExecStart=/usr/bin/env bash -lc 'exec bash "$FREETOKEN_RUNNER"'
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
