{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m pip install mkdocs-material && (cd docs && mkdocs build) && mkdir -p deploy/site && cp docs/index.html deploy/index.html && cp -r docs/dashboard deploy/dashboard && cp -r docs/site/* deploy/site/",
  "outputDirectory": "deploy",
  "functions": {
    "api/dashboard-live.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/dashboard/dashboard.json",
      "destination": "https://kafka2306.github.io/agent-resources/dashboard/dashboard.json"
    }
  ],
  "headers": [
    {
      "source": "/dashboard/dashboard.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
