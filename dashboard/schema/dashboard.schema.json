{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kafka2306.github.io/agent-resources/dashboard/schema/dashboard.schema.json",
  "title": "Agent Resources Dashboard Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "summary", "repositories", "workItems", "activity"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "summary": {"$ref": "#/$defs/summary"},
    "repositories": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "workItems": {"type": "array", "items": {"$ref": "#/$defs/workItem"}},
    "activity": {"type": "array", "items": {"$ref": "#/$defs/activityItem"}},
    "stats": {"$ref": "#/$defs/stats"},
    "openclawRuntime": {"$ref": "#/$defs/openclawRuntime"},
    "repositoryOperations": {"$ref": "#/$defs/repositoryOperations"}
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryCount", "workItemCount", "activityCount"],
      "properties": {
        "repositoryCount": {"type": "integer", "minimum": 0},
        "workItemCount": {"type": "integer", "minimum": 0},
        "activityCount": {"type": "integer", "minimum": 0}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "name", "url", "group", "visibility", "updatedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "group": {"type": "string", "minLength": 1},
        "visibility": {"type": "string", "const": "public"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "publicLinks": {
          "type": "array",
          "items": {"$ref": "#/$defs/publicLink"},
          "uniqueItems": true
        }
      }
    },
    "publicLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {"type": "string", "enum": ["front", "pages"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repositoryId", "kind", "number", "title", "url", "state", "updatedAt", "lane", "laneReason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repositoryId": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["issue", "pull_request", "workflow_run"]},
        "number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "state": {"type": "string", "enum": ["open", "closed", "queued", "in_progress", "completed", "failed", "cancelled", "skipped"]},
        "updatedAt": {"type": "string", "format": "date-time"},
        "lane": {"type": "string", "enum": ["working", "waiting", "done", "failed"]},
        "laneReason": {"type": "string", "minLength": 1}
      }
    },
    "activityItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repositoryId", "kind", "occurredAt", "url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repositoryId": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["issue", "pull_request", "workflow_run", "commit"]},
        "occurredAt": {"type": "string", "format": "date-time"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "scope", "timezone", "publicRepositories", "archivedPublicRepositories", "monthly"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "const": "public"},
        "timezone": {"type": "string", "const": "Asia/Tokyo"},
        "publicRepositories": {"type": "integer", "minimum": 0},
        "archivedPublicRepositories": {"type": "integer", "minimum": 0},
        "monthly": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/monthlyStats"}}
      }
    },
    "monthlyStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "commits", "prsCreated", "prsMerged", "issuesCreated", "issuesClosed", "partial"],
      "properties": {
        "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
        "commits": {"type": "integer", "minimum": 0},
        "prsCreated": {"type": "integer", "minimum": 0},
        "prsMerged": {"type": "integer", "minimum": 0},
        "issuesCreated": {"type": "integer", "minimum": 0},
        "issuesClosed": {"type": "integer", "minimum": 0},
        "partial": {"type": "boolean"}
      }
    },
    "openclawRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "collectedAt", "agents", "automations"],
      "properties": {
        "scope": {"type": "string", "const": "domain-agents"},
        "collectedAt": {"type": "string", "format": "date-time"},
        "agents": {"type": "array", "items": {"$ref": "#/$defs/openclawAgent"}},
        "automations": {"type": "array", "items": {"$ref": "#/$defs/openclawAutomation"}}
      }
    },
    "openclawAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionCount", "models"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "sessionCount": {"type": "integer", "minimum": 0},
        "models": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 160}, "uniqueItems": true}
      }
    },
    "openclawAutomation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agentId", "name", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "agentId": {"type": "string", "minLength": 1, "maxLength": 80},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "status": {"type": "string", "enum": ["disabled", "running", "ok", "error", "skipped", "idle", "unknown"]}
      }
    },
    "repositoryOperations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "owner", "collectedAt", "repositories", "branches", "summary"],
      "properties": {
        "scope": {"type": "string", "const": "public-nonarchived-owned-repositories"},
        "owner": {"type": "string", "minLength": 1},
        "collectedAt": {"type": "string", "format": "date-time"},
        "repositories": {"type": "array", "items": {"$ref": "#/$defs/repositoryOperationRepository"}},
        "branches": {"type": "array", "items": {"$ref": "#/$defs/repositoryOperationBranch"}},
        "summary": {"$ref": "#/$defs/repositoryOperationSummary"}
      }
    },
    "repositoryOperationRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fullName", "url", "group", "classificationSource"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "fullName": {"type": "string", "minLength": 3},
        "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "group": {"type": "string", "minLength": 1},
        "classificationSource": {"type": "string", "enum": ["agent-zone-topic", "unclassified"]}
      }
    },
    "repositoryOperationBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "status", "reason"],
      "properties": {
        "repository": {"type": "string", "minLength": 3},
        "branch": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["candidate", "confirmed", "deleted", "blocked"]},
        "reason": {"type": "string", "minLength": 1},
        "commitDate": {"type": "string", "format": "date-time"},
        "firstSeen": {"type": "string", "format": "date-time"},
        "confirmedAt": {"type": "string", "format": "date-time"}
      }
    },
    "repositoryOperationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryCount", "classifiedCount", "unclassifiedCount", "candidateCount", "confirmedCount", "deletedCount", "blockedCount"],
      "properties": {
        "repositoryCount": {"type": "integer", "minimum": 0},
        "classifiedCount": {"type": "integer", "minimum": 0},
        "unclassifiedCount": {"type": "integer", "minimum": 0},
        "candidateCount": {"type": "integer", "minimum": 0},
        "confirmedCount": {"type": "integer", "minimum": 0},
        "deletedCount": {"type": "integer", "minimum": 0},
        "blockedCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}